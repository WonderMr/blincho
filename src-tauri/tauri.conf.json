{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blincho",
  "version": "1.5.3",
  "identifier": "com.myeyes.app",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "create": false, "title": "Blincho", "width": 1040, "height": 760, "minWidth": 780, "minHeight": 620, "titleBarStyle": "Overlay", "hiddenTitle": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' blob: data:" }
  },
  "bundle": { "active": false, "icon": ["../assets/icon.png"] }
}
